# =============================================================================
# Spinner - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Database ---
DB_PATH=./spinner.db

# --- Server ---
PORT=8080

# --- JWT ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-secret

# --- Frontend URL (for magic-link redirect after email verification) ---
FRONTEND_URL=http://localhost:5173

# --- Backend Base URL (for constructing magic-link URLs in emails) ---
# Leave empty to auto-detect from incoming requests.
# Set explicitly in production, e.g.: https://spinner.yourdomain.com
BASE_URL=

# --- SMTP Configuration (for passwordless magic-link login) ---
# For local development with Mailpit (Docker): use localhost:1025
# For production: use your SMTP provider (e.g., SendGrid, Gmail, Resend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@spinner.local
